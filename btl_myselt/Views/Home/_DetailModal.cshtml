<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-info-circle me-2"></i>Xem nhanh phương tiện</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 row g-3">
                <div class="col-md-5">
                    <img id="detailImg" src="" class="img-fluid rounded border mb-2" style="width: 100%; height: 220px; object-fit: cover;" onerror="this.src='https://placehold.co/300x220?text=No+Image'" />
                    <div id="detailThumbnails" class="d-flex gap-2 overflow-auto"></div>
                </div>
                <div class="col-md-7">
                    <h4 id="detailName" class="text-primary fw-bold mb-2"></h4>
                    <h5 id="detailPrice" class="text-danger fw-bold mb-3"></h5>
                    <ul class="list-group list-group-flush small mb-3">
                        <li class="list-group-item px-0 d-flex justify-content-between"><span class="text-muted">Loại xe:</span><strong id="detailCategory"></strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span class="text-muted">Khu dân cư:</span><strong id="detailCommunity"></strong></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span class="text-muted">Chủ sở hữu:</span><span id="detailOwner" class="text-dark fw-semibold"></span></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span class="text-muted">Số điện thoại:</span><span id="detailPhone" class="text-primary fw-bold"></span></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span class="text-muted">Hình thức:</span><span id="detailShareType"></span></li>
                        <li class="list-group-item px-0 d-flex justify-content-between"><span class="text-muted">Tình trạng:</span><span id="detailCondition"></span></li>
                    </ul>
                    <div class="bg-light p-2 rounded small" id="detailDescription"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <a id="homeDetailPageBtn" href="#" class="btn btn-primary fw-semibold">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Trang chi tiết & Đặt xe
                </a>
            </div>
        </div>
    </div>
</div>
