@using btl_myselt.Models.Entities
@{
    ViewData["Title"] = "Đăng ký thành viên - NeighborRide";
    ViewData["Description"] = "Tạo tài khoản cư dân trên NeighborRide để bắt đầu thuê xe, chia sẻ phương tiện nhàn rỗi và kết nối an toàn với hàng xóm láng giềng.";
    ViewData["Keywords"] = "đăng ký tài khoản, cư dân nội khu, thuê xe, chia sẻ phương tiện, NeighborRide";
    var communities = ViewBag.Communities as List<Community> ?? new List<Community>();
}

<main class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7 col-xl-6">
            <div class="card shadow-sm border-0 p-3 p-sm-4">
                <h1 class="fw-bold text-center text-primary fs-3 mb-1">Tạo Tài Khoản Cư Dân</h1>
                <p class="text-center text-muted small mb-3">Tham gia cộng đồng chia sẻ phương tiện văn minh</p>

                <!-- Hộp thông báo lỗi/thành công -->
                <div id="registerAlert" class="alert d-none py-2 small" role="alert"></div>

                <form id="registerForm">
                    <div class="mb-3">
                        <label for="regFullName" class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" id="regFullName" class="form-control py-2" placeholder="Nguyễn Văn A" autocomplete="name" aria-label="Họ và tên" />
                        <span id="errFullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <label for="regEmail" class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" id="regEmail" class="form-control py-2" placeholder="name@domain.com" autocomplete="email" aria-label="Địa chỉ email" />
                            <span id="errEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="regPhone" class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" id="regPhone" class="form-control py-2" placeholder="09xxxxxxxx" autocomplete="tel" aria-label="Số điện thoại" />
                            <span id="errPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="regCommunityId" class="form-label small fw-semibold">Khu dân cư sinh sống <span class="text-danger">*</span></label>
                        <select id="regCommunityId" class="form-select py-2" aria-label="Chọn khu dân cư sinh sống">
                            <option value="0">-- Chọn khu dân cư --</option>
                            @foreach (var c in communities)
                            {
                                <option value="@c.Id">@c.Name (@c.Address)</option>
                            }
                        </select>
                        <span id="errCommunity" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <label for="regPassword" class="form-label small fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" id="regPassword" class="form-control py-2" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" aria-label="Mật khẩu" />
                            <span id="errPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="regConfirmPassword" class="form-label small fw-semibold">Nhập lại mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" id="regConfirmPassword" class="form-control py-2" placeholder="Nhập lại mật khẩu" autocomplete="new-password" aria-label="Nhập lại mật khẩu" />
                            <span id="errConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" id="btnRegister" class="btn btn-primary w-100 fw-semibold py-2 mb-3" aria-label="Đăng ký tài khoản">
                        Đăng Ký
                    </button>

                    <div class="text-center small">
                        Đã có tài khoản? <a asp-action="Login" class="text-decoration-none fw-semibold">Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        var emailRegex = /^[\w-\.]+@@([\w-]+\.)+[\w-]{2,4}$/;
        var phoneRegex = /^0\d{9}$/;

        $('#registerForm').on('submit', function (e) {
            e.preventDefault();

            // Xóa thông báo lỗi cũ
            $('#registerAlert').addClass('d-none').removeClass('alert-danger alert-success').text('');
            $('span[id^="err"]').text('');

            var fullName = $('#regFullName').val().trim();
            var email = $('#regEmail').val().trim();
            var phone = $('#regPhone').val().trim();
            var communityId = parseInt($('#regCommunityId').val()) || 0;
            var password = $('#regPassword').val();
            var confirmPassword = $('#regConfirmPassword').val();

            var isValid = true;

            if (!fullName) {
                $('#errFullName').text('Vui lòng nhập họ và tên!');
                isValid = false;
            }
            
            if (!email) {
                $('#errEmail').text('Vui lòng nhập email!');
                isValid = false;
            } else if (!emailRegex.test(email)) {
                $('#errEmail').text('Email không đúng định dạng (Ví dụ: name@domain.com)!');
                isValid = false;
            }

            if (!phone) {
                $('#errPhone').text('Vui lòng nhập số điện thoại!');
                isValid = false;
            } else if (!phoneRegex.test(phone)) {
                $('#errPhone').text('Số điện thoại phải gồm 10 số và bắt đầu bằng số 0!');
                isValid = false;
            }

            if (communityId <= 0) {
                $('#errCommunity').text('Vui lòng chọn khu dân cư sinh sống!');
                isValid = false;
            }

            if (!password) {
                $('#errPassword').text('Vui lòng nhập mật khẩu!');
                isValid = false;
            } else if (password.length < 6) {
                $('#errPassword').text('Mật khẩu phải từ 6 ký tự trở lên!');
                isValid = false;
            }

            if (!confirmPassword) {
                $('#errConfirmPassword').text('Vui lòng xác nhận lại mật khẩu!');
                isValid = false;
            } else if (password !== confirmPassword) {
                $('#errConfirmPassword').text('Mật khẩu xác nhận không khớp!');
                isValid = false;
            }

            if (!isValid) return;

            // Dữ liệu hợp lệ -> Gửi AJAX
            var postData = {
                fullName: fullName,
                email: email,
                phoneNumber: phone,
                communityId: communityId,
                password: password,
                confirmPassword: confirmPassword
            };

            $('#btnRegister').prop('disabled', true).text('Đang xử lý...');

            $.ajax({
                url: '/Account/Register',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(postData),
                success: function (res) {
                    $('#btnRegister').prop('disabled', false).text('Đăng Ký');

                    if (res.success) {
                        $('#registerAlert')
                            .removeClass('d-none alert-danger')
                            .addClass('alert-success')
                            .text(res.message);

                        $('#registerForm input, #registerForm select, #btnRegister').prop('disabled', true);

                        // Tự động chuyển sang trang Đăng nhập sau 1.2s
                        setTimeout(function () {
                            window.location.href = res.redirectUrl;
                        }, 1200);
                    } else {
                        // Thất bại -> Báo lỗi, giữ nguyên toàn bộ form
                        $('#registerAlert')
                            .removeClass('d-none alert-success')
                            .addClass('alert-danger')
                            .text(res.message);
                    }
                },
                error: function () {
                    $('#btnRegister').prop('disabled', false).text('Đăng Ký');
                    $('#registerAlert')
                        .removeClass('d-none alert-success')
                        .addClass('alert-danger')
                        .text('Lỗi kết nối tới máy chủ, vui lòng thử lại!');
                }
            });
        });
    </script>
}
