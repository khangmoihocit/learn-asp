<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Chi tiết phương tiện</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body row">
                <div class="col-md-5">
                    <img id="detailImg" src="" class="img-fluid rounded border mb-2" style="width: 100%; height: 220px; object-fit: cover;" onerror="this.src='https://placehold.co/300x220?text=No+Image'" />
                </div>
                <div class="col-md-7">
                    <h4 id="detailName" class="text-primary fw-bold mb-2"></h4>
                    <p class="mb-1"><strong>Giá thuê:</strong> <span id="detailPrice" class="text-danger fw-bold"></span></p>
                    <p class="mb-1"><strong>Loại xe:</strong> <span id="detailCategory"></span></p>
                    <p class="mb-1"><strong>Khu dân cư:</strong> <span id="detailCommunity"></span></p>
                    <p class="mb-1"><strong>Chủ sở hữu:</strong> <span id="detailOwner"></span></p>
                    <p class="mb-1"><strong>Hình thức:</strong> <span id="detailShareType"></span></p>
                    <p class="mb-1"><strong>Trạng thái:</strong> <span id="detailStatus"></span></p>
                    <p class="mb-1"><strong>Tình trạng:</strong> <span id="detailCondition"></span></p>
                    <p class="mb-1"><strong>Mô tả:</strong> <span id="detailDescription"></span></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
