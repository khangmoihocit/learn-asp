@model Vehicle

<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="createForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Thêm phương tiện mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Tên xe <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Honda Vision 2023" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Trạng thái xe</label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<VehicleStatus>()"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Loại xe</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Khu dân cư</label>
                        <select asp-for="CommunityId" class="form-select" asp-items="ViewBag.Communities" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Chủ sở hữu</label>
                        <select asp-for="OwnerId" class="form-select" asp-items="ViewBag.Owners" required></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Hình thức chia sẻ</label>
                        <select id="createShareType" asp-for="ShareType" class="form-select" asp-items="Html.GetEnumSelectList<ShareType>()"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Giá thuê / ngày (VNĐ)</label>
                        <input type="number" id="createPrice" asp-for="Price" class="form-control" value="0" readonly style="background: #eee;" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Ảnh đại diện ban đầu</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tình trạng xe</label>
                        <input asp-for="Condition" class="form-control" placeholder="Ví dụ: Xe mới 98%" />
                        <span asp-validation-for="Condition" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Mô tả chi tiết</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu xe</button>
                </div>
            </form>
        </div>
    </div>
</div>
