@model IEnumerable<btl_myselt.Models.Entities.Vehicle>
@using btl_myselt.Models.Enums

@{
    ViewData["Title"] = "Quản lý phương tiện";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Danh sách phương tiện</h3>
    <button type="button" class="btn btn-primary" onclick="openCreate()">
        <i class="bi bi-plus-circle me-1"></i> Thêm xe mới
    </button>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead>
        <tr>
            <th style="width: 70px;">Ảnh</th>
            <th>Tên xe</th>
            <th>Loại xe</th>
            <th>Khu dân cư</th>
            <th>Chủ sở hữu</th>
            <th>Hình thức</th>
            <th>Giá thuê/ngày</th>
            <th>Trạng thái</th>
            <th class="text-center" style="width: 170px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var primaryImg = item.Images.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? "/images/default-vehicle.png";
                <tr>
                    <td>
                        <img src="@primaryImg" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='https://placehold.co/50x50?text=Xe'" />
                    </td>
                    <td class="fw-bold text-primary">@item.Name</td>
                    <td>@(item.Category?.Name ?? "—")</td>
                    <td>@(item.Community?.Name ?? "—")</td>
                    <td>@(item.Owner?.FullName ?? "—")</td>
                    <td>
                        @if (item.ShareType == ShareType.Free)
                        {
                            <span class="badge bg-info text-dark">Miễn phí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Cho thuê</span>
                        }
                    </td>
                    <td class="text-danger fw-bold">@item.Price.ToString("N0") đ</td>
                    <td>
                        @switch (item.Status)
                        {
                            case VehicleStatus.Available:
                                <span class="badge bg-success">Sẵn sàng</span>
                                break;
                            case VehicleStatus.Rented:
                                <span class="badge bg-warning text-dark">Đang thuê</span>
                                break;
                            case VehicleStatus.Maintenance:
                                <span class="badge bg-danger">Bảo trì</span>
                                break;
                            case VehicleStatus.Hidden:
                                <span class="badge bg-secondary">Tạm ẩn</span>
                                break;
                        }
                    </td>
                    <td class="text-center">
                        @if (item.Status == VehicleStatus.Hidden)
                        {
                            <button type="button" class="btn btn-sm btn-success me-1" onclick="approveVehicle(@item.Id)" title="Duyệt xe hiển thị"><i class="bi bi-check-lg"></i></button>
                        }
                        <button type="button" class="btn btn-sm btn-info text-white me-1" onclick="openDetail(@item.Id)" title="Chi tiết"><i class="bi bi-eye"></i></button>
                        <button type="button" class="btn btn-sm btn-secondary text-white me-1" onclick="openImages(@item.Id)" title="Quản lý ảnh"><i class="bi bi-images"></i></button>
                        <button type="button" class="btn btn-sm btn-warning me-1" onclick="openEdit(@item.Id)" title="Sửa"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="openDelete(@item.Id, '@item.Name')" title="Xóa"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center py-4 text-muted">Chưa có phương tiện nào trong hệ thống!</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_CreateModal" model="new Vehicle()" />
<partial name="_EditModal" model="new Vehicle()" />
<partial name="_DetailModal" />
<partial name="_DeleteModal" />
<partial name="_ImageModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var currentVehicleId = 0;

        // Khóa ô giá khi chọn Miễn phí (dùng readonly để form vẫn gửi được giá trị 0 lên server)
        $('#createShareType').change(function () {
            if ($(this).val() == '0') {
                $('#createPrice').val(0).prop('readonly', true).css('background', '#eee');
            } else {
                $('#createPrice').val(100000).prop('readonly', false).css('background', '#fff');
            }
        });

        $('#editShareType').change(function () {
            if ($(this).val() == '0') {
                $('#editPrice').val(0).prop('readonly', true).css('background', '#eee');
            } else {
                $('#editPrice').prop('readonly', false).css('background', '#fff');
            }
        });

        // Thêm mới: dùng FormData để upload file ảnh ban đầu
        function openCreate() {
            $('#createForm')[0].reset();
            $('#createPrice').val(0).prop('readonly', true).css('background', '#eee');
            $('#createModal').modal('show');
        }

        $('#createForm').submit(function (e) {
            e.preventDefault();
            if (!$(this).valid()) return;
            $.ajax({
                url: '/Admin/Vehicle/Create',
                type: 'POST',
                data: new FormData(this),
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        // Sửa xe: gọi GET lấy thông tin điền vào form, submit gửi POST
        function openEdit(id) {
            $.get('/Admin/Vehicle/GetVehicle/' + id, function (res) {
                if (res.success) {
                    var v = res.data;
                    $('#editId').val(v.id);
                    $('#editName').val(v.name);
                    $('#editStatus').val(v.status);
                    $('#editCategoryId').val(v.categoryId);
                    $('#editCommunityId').val(v.communityId);
                    $('#editOwnerId').val(v.ownerId);
                    $('#editShareType').val(v.shareType);
                    $('#editPrice').val(v.price);
                    $('#editCondition').val(v.condition);
                    $('#editDescription').val(v.description);

                    if (v.shareType == 0) {
                        $('#editPrice').prop('readonly', true).css('background', '#eee');
                    } else {
                        $('#editPrice').prop('readonly', false).css('background', '#fff');
                    }

                    $('#editModal').modal('show');
                } else {
                    alert(res.message);
                }
            });
        }

        $('#editForm').submit(function (e) {
            e.preventDefault();
            if (!$(this).valid()) return;
            var id = $('#editId').val();
            $.ajax({
                url: '/Admin/Vehicle/Edit/' + id,
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        // Xem chi tiết: nạp thông tin xe và hiển thị modal
        function openDetail(id) {
            $.get('/Admin/Vehicle/GetVehicleDetails/' + id, function (res) {
                if (res.success) {
                    var v = res.data;
                    $('#detailName').text(v.name);
                    $('#detailPrice').text(Number(v.price).toLocaleString() + ' đ/ngày');
                    $('#detailCategory').text(v.categoryName);
                    $('#detailCommunity').text(v.communityName);
                    $('#detailOwner').text(v.ownerName + ' (' + v.ownerPhone + ')');
                    $('#detailShareType').text(v.shareType);
                    $('#detailStatus').text(v.status);
                    $('#detailCondition').text(v.condition || 'Bình thường');
                    $('#detailDescription').text(v.description || 'Không có mô tả');

                    var imgUrl = (v.images && v.images.length > 0) ? v.images[0].imageUrl : '/images/default-vehicle.png';
                    $('#detailImg').attr('src', imgUrl);

                    $('#detailModal').modal('show');
                } else {
                    alert(res.message);
                }
            });
        }

        // Xóa xe: xác nhận và gửi POST xóa xe cùng toàn bộ ảnh liên quan
        function openDelete(id, name) {
            $('#deleteId').val(id);
            $('#deleteName').text(name);
            $('#deleteModal').modal('show');
        }

        function confirmDelete() {
            var id = $('#deleteId').val();
            $.post('/Admin/Vehicle/Delete/' + id, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        }

        // Quản lý ảnh: tải ảnh phụ, đổi ảnh chính và xóa ảnh riêng lẻ
        function openImages(id) {
            currentVehicleId = id;
            $('#imageVehicleId').val(id);
            loadImages(id);
            $('#imageModal').modal('show');
        }

        function loadImages(vehicleId) {
            $.get('/Admin/Vehicle/GetVehicleImages?vehicleId=' + vehicleId, function (res) {
                if (res.success) {
                    var html = '';
                    res.images.forEach(function (img) {
                        html += `
                            <div class="col-4 text-center">
                                <img src="${img.imageUrl}" class="rounded mb-2" style="width: 100%; height: 100px; object-fit: cover;">
                                ${img.isPrimary ? '<span class="badge bg-primary mb-1 d-block">Ảnh chính</span>' : `<button type="button" class="btn btn-sm btn-outline-primary w-100 mb-1" onclick="setPrimary(${img.id})">Đặt ảnh chính</button>`}
                                <button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="removeImage(${img.id})">Xóa</button>
                            </div>`;
                    });
                    $('#imageList').html(html || '<p class="text-center text-muted">Chưa có ảnh</p>');
                }
            });
        }

        $('#uploadImageForm').submit(function (e) {
            e.preventDefault();
            $.ajax({
                url: '/Admin/Vehicle/UploadMoreImage',
                type: 'POST',
                data: new FormData(this),
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.success) {
                        $('#uploadImageForm')[0].reset();
                        loadImages(currentVehicleId);
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        function setPrimary(imageId) {
            $.post('/Admin/Vehicle/SetPrimaryImage', { imageId: imageId, vehicleId: currentVehicleId }, function (res) {
                if (res.success) loadImages(currentVehicleId);
            });
        }

        function removeImage(imageId) {
            if (!confirm('Bạn có chắc muốn xóa ảnh này?')) return;
            $.post('/Admin/Vehicle/DeleteImage', { imageId: imageId }, function (res) {
                if (res.success) loadImages(currentVehicleId);
            });
        }

        function approveVehicle(id) {
            if (!confirm('Bạn có chắc chắn muốn phê duyệt phương tiện này để hiển thị công khai?')) return;
            $.post('/Admin/Vehicle/Approve', { id: id }, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        }
    </script>
}
