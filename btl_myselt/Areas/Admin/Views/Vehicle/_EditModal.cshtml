@model Vehicle

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editId" name="Id" />

                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Chỉnh sửa thông tin xe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Tên xe <span class="text-danger">*</span></label>
                        <input asp-for="Name" id="editName" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Trạng thái xe</label>
                        <select asp-for="Status" id="editStatus" class="form-select" asp-items="Html.GetEnumSelectList<VehicleStatus>()"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Loại xe</label>
                        <select asp-for="CategoryId" id="editCategoryId" class="form-select" asp-items="ViewBag.Categories" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Khu dân cư</label>
                        <select asp-for="CommunityId" id="editCommunityId" class="form-select" asp-items="ViewBag.Communities" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Chủ sở hữu</label>
                        <select asp-for="OwnerId" id="editOwnerId" class="form-select" asp-items="ViewBag.Owners" required></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Hình thức chia sẻ</label>
                        <select id="editShareType" asp-for="ShareType" class="form-select" asp-items="Html.GetEnumSelectList<ShareType>()"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Giá thuê / ngày (VNĐ)</label>
                        <input type="number" id="editPrice" asp-for="Price" class="form-control" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Tình trạng xe</label>
                        <input asp-for="Condition" id="editCondition" class="form-control" />
                        <span asp-validation-for="Condition" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Mô tả chi tiết</label>
                        <textarea asp-for="Description" id="editDescription" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
