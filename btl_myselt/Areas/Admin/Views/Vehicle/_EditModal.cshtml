<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editId" name="Id" />

                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Chỉnh sửa thông tin xe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Tên xe</label>
                        <input type="text" id="editName" name="Name" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Trạng thái xe</label>
                        <select id="editStatus" name="Status" class="form-select" asp-items="Html.GetEnumSelectList<VehicleStatus>()"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Loại xe</label>
                        <select id="editCategoryId" name="CategoryId" class="form-select" asp-items="ViewBag.Categories" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Khu dân cư</label>
                        <select id="editCommunityId" name="CommunityId" class="form-select" asp-items="ViewBag.Communities" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Chủ sở hữu</label>
                        <select id="editOwnerId" name="OwnerId" class="form-select" asp-items="ViewBag.Owners" required></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Hình thức chia sẻ</label>
                        <select id="editShareType" name="ShareType" class="form-select" asp-items="Html.GetEnumSelectList<ShareType>()"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Giá thuê / ngày (VNĐ)</label>
                        <input type="number" id="editPrice" name="Price" class="form-control" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Tình trạng xe</label>
                        <input type="text" id="editCondition" name="Condition" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Mô tả chi tiết</label>
                        <textarea id="editDescription" name="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
