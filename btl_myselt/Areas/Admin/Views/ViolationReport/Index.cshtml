@model IEnumerable<btl_myselt.Models.Entities.ViolationReport>

@{
    ViewData["Title"] = "Quản lý báo cáo vi phạm";
    Layout = "_AdminLayout";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-shield-exclamation text-danger me-2"></i>Quản lý báo cáo vi phạm</h4>
        <p class="text-secondary small mb-0">Tiếp nhận và xử lý các khiếu nại, vi phạm của cư dân trong cộng đồng</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(selectedStatus) ? "btn-primary" : "btn-outline-secondary")">Tất cả</a>
        <a asp-action="Index" asp-route-status="Pending" class="btn btn-sm @(selectedStatus == "Pending" ? "btn-warning" : "btn-outline-warning text-dark")">Chờ xử lý</a>
        <a asp-action="Index" asp-route-status="Resolved" class="btn btn-sm @(selectedStatus == "Resolved" ? "btn-success" : "btn-outline-success")">Đã giải quyết</a>
        <a asp-action="Index" asp-route-status="Dismissed" class="btn btn-sm @(selectedStatus == "Dismissed" ? "btn-secondary" : "btn-outline-secondary")">Bỏ qua</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Người báo cáo</th>
                    <th>Đối tượng</th>
                    <th>Lý do & Mô tả</th>
                    <th>Ghi chú Admin</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Xử lý</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td>
                                <div>@(item.Reporter?.FullName ?? "—")</div>
                                <small class="text-muted">@(item.Reporter?.PhoneNumber ?? "—")</small>
                            </td>
                            <td>
                                <span class="badge bg-dark">@item.TargetType #@item.TargetId</span>
                            </td>
                            <td>
                                <strong class="text-danger d-block">@item.Reason</strong>
                                <small class="text-secondary">@(item.Description ?? "Không có mô tả chi tiết.")</small>
                            </td>
                            <td>
                                <span class="small text-muted fst-italic">@(string.IsNullOrEmpty(item.AdminNote) ? "Chưa có ghi chú" : item.AdminNote)</span>
                            </td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                }
                                else if (item.Status == "Resolved")
                                {
                                    <span class="badge bg-success">Đã giải quyết</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Bỏ qua</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm" onclick="openResolveModal(@item.Id, '@item.Status', '@(item.AdminNote ?? "")')">
                                    <i class="bi bi-pencil-square me-1"></i>Xử lý
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Không có báo cáo vi phạm nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="resolveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">Xử lý báo cáo vi phạm</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="resolveForm" onsubmit="event.preventDefault(); submitResolve();">
                <input type="hidden" id="reportId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Cập nhật trạng thái</label>
                        <select id="reportStatus" class="form-select">
                            <option value="Pending">Chờ xử lý</option>
                            <option value="Resolved">Đã giải quyết</option>
                            <option value="Dismissed">Bỏ qua (Báo cáo không đúng)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú của Admin</label>
                        <textarea id="adminNote" class="form-control" rows="3" placeholder="Nhập ghi chú hoặc biện pháp xử lý..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Lưu kết quả</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openResolveModal(id, status, note) {
            $('#reportId').val(id);
            $('#reportStatus').val(status);
            $('#adminNote').val(note);
            $('#resolveModal').modal('show');
        }

        function submitResolve() {
            var data = {
                id: $('#reportId').val(),
                status: $('#reportStatus').val(),
                adminNote: $('#adminNote').val()
            };

            $.post('/Admin/ViolationReport/Resolve', data, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        }
    </script>
}
