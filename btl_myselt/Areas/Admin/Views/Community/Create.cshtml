@model btl_myselt.Models.Entities.Community

@{
    ViewData["Title"] = "Thêm khu dân cư mới";
}

<div class="container-fluid px-0">
        <div class="card-header bg-primary text-white mb-4 py-2">
            <h5 class="card-title fw-bold mb-0 text-center">Thêm khu dân cư / Chung cư mới</h5>
        </div>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Tên khu dân cư/chung cư</label>
                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Vinhomes Ocean Park, Chung cư Ngoại Giao Đoàn..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" placeholder="Ví dụ: Gia Lâm, Hà Nội" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Lưu khu dân cư
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                </div>
            </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}