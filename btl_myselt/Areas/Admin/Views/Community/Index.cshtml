@model IEnumerable<btl_myselt.Models.Entities.Community>
@{
    ViewData["Title"] = "Quản lý khu dân cư";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark">Danh sách khu dân cư</h3>
    <a asp-action="Create" class="btn btn-ptrimary bg-primary" style="color: white;">
        <i class="bi bi-plus-circle me-1"></i> Thêm khu dân cư mới
    </a>
</div>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên khu dân cư</th>
            <th>Địa chỉ</th>
            <th>Active</th>
            <th class="text-center" style="width: 180px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold text-muted">#@item.Id</td>
                    <td class="fw-semibold text-primary">@item.Name</td>
                    <td>@item.Address</td>
                    <td>d</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                            Sửa
                        </a>
                        <button type="button" class="btn btn-danger btn-sm btn-delete-confirm" data-bs-target="#deleteModal"
                            data-bs-toggle="modal">
                            Xóa
                        </button>
                    </td>
                </tr>

                <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title fw-bold">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body text-center py-4">
                                    <p class="fs-5 text-secondary mb-2" id="globalDeleteMessage">Bạn có chắc chắn muốn
                                        xóa mục
                                        này?</p>
                                    <h4 class="fw-bold text-danger mb-3" id="globalDeleteTargetName"></h4>
                                    <small class="text-muted">Hành động này không thể hoàn tác sau khi thực
                                        hiện.</small>
                                </div>

                                <div class="modal-footer justify-content-center border-0 pt-0">
                                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn btn-danger px-4 fw-semibold">Đồng ý Xóa</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center py-4 text-muted">
                    Chưa có dữ liệu khu dân cư nào. Hãy bấm "Thêm khu dân cư mới"!
                </td>
            </tr>
        }
    </tbody>
</table>
