@page "/trang-thu-hai/{solanlap:int?}"
<h1>day la page 2</h1>

@{
    var solanlapObject = this.Request.RouteValues["solanlap"] ?? "0";

    int solanlap = Int32.Parse(solanlapObject.ToString());

    <ol>
        @for (int i = 0; i <= solanlap; i++)
        {
            <li>Muc thu @i</li>
        }
    </ol>
}